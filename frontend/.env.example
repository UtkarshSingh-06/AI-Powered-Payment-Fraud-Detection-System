# Frontend Environment Variables
# Copy this file to .env and update with your actual values
# Vite dev server: http://localhost:3002 (port set in vite.config.js)

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000/ws

# Environment
VITE_NODE_ENV=development

# Application Name
VITE_APP_NAME=FraudShield AI

# Public site URL (canonical, Open Graph, sitemap absolute links)
VITE_SITE_URL=http://localhost:3002

# Optional analytics collector (only used after cookie consent)
VITE_ANALYTICS_ENDPOINT=
