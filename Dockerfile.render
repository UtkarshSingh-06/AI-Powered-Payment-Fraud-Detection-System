# Render production image: Vite frontend + Node backend (monolith)
FROM node:20-alpine AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
ENV VITE_API_URL=/api
ENV VITE_WS_URL=
RUN npm run build

FROM node:20-alpine
WORKDIR /app

COPY packages/contracts ./packages/contracts
COPY packages/platform-kafka ./packages/platform-kafka
COPY packages/platform-auth ./packages/platform-auth
COPY packages/feature-schema ./packages/feature-schema
COPY backend/package*.json ./
RUN sed -i 's|file:../packages|file:./packages|g' package.json \
  && npm install --omit=dev

COPY backend/ .
COPY --from=frontend-build /app/frontend/dist ./public

ENV NODE_ENV=production
ENV SERVE_FRONTEND=true

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:${PORT}/api/health || exit 1

CMD ["npm", "run", "start:render"]
