{
  "name": "fraudshield-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for FraudShield AI - AI-Powered Payment Fraud Detection System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:render": "node scripts/renderBootstrap.js && node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seedData.js",
    "migrate": "node scripts/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
