# Backend Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (REQUIRED - Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins; Vite dev default is http://localhost:3002)
CORS_ORIGIN=http://localhost:3002,http://localhost:3000

# Database Configuration (if using external database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraudshield
PG_SSL=false
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fraudshield-backend
DEFAULT_TENANT_ID=default
FIELD_ENCRYPTION_KEY=change-me-32-characters-minimum-key

# WebSocket Configuration
WS_PORT=5000
INFERENCE_URL=http://localhost:8000
INFERENCE_TIMEOUT_MS=40
RATE_LIMIT_PER_MINUTE=120
