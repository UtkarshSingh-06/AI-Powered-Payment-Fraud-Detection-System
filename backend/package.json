    "detection",
    "payment",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fraudshield/contracts": "file:../packages/contracts",
    "@fraudshield/feature-schema": "file:../packages/feature-schema",
    "@fraudshield/platform-auth": "file:../packages/platform-auth",
    "@fraudshield/platform-kafka": "file:../packages/platform-kafka",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.1",
